{
  "name": "cliv",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "pnpm test:e2e:desktop:portable",
    "test:e2e:desktop:portable": "pnpm test:e2e:desktop:standalone && pnpm test:e2e:desktop:metadata && pnpm test:e2e:desktop:missing-reply",
    "test:e2e:desktop:unix": "pnpm test:e2e:desktop:portable && pnpm test:e2e:desktop:trusted-caller-only && pnpm test:e2e:desktop:gemini-pid-only",
    "test:e2e:desktop:standalone": "CLIV_DESKTOP_SCENARIO=standalone wdio run e2e/desktop/wdio.conf.js",
    "test:e2e:desktop:metadata": "CLIV_DESKTOP_SCENARIO=metadata wdio run e2e/desktop/wdio.conf.js",
    "test:e2e:desktop:missing-reply": "CLIV_DESKTOP_SCENARIO=missing-reply wdio run e2e/desktop/wdio.conf.js",
    "test:e2e:desktop:gemini-pid-only": "CLIV_DESKTOP_SCENARIO=gemini-pid-only wdio run e2e/desktop/wdio.conf.js",
    "test:e2e:desktop:trusted-caller-only": "CLIV_DESKTOP_SCENARIO=trusted-caller-only wdio run e2e/desktop/wdio.conf.js",
    "test:docs": "python3 scripts/validate_testing_docs.py",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bash ./scripts/tauri_build.sh local",
    "tauri:build:local": "bash ./scripts/tauri_build.sh local",
    "tauri:build:release": "bash ./scripts/tauri_build.sh release",
    "tauri:build:install-deb": "bash ./scripts/build_install_deb.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@uiw/react-markdown-preview": "^5.1.5",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.19.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/mocha-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
