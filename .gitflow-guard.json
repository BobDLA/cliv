{
  "blocked_paths": [
    "(^|/)\\.env(\\..+)?$",
    ".*\\.pem$",
    ".*\\.key$",
    "(^|/)secrets(/|$)",
    "(^|/)credentials(/|$)"
  ],
  "allowlist": [
    "example[_-]?token",
    "fake[_-]?secret",
    "test[_-]?key",
    "placeholder"
  ],
  "patterns": [
    {
      "name": "OpenAI key",
      "regex": "sk-[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "GitHub token",
      "regex": "(ghp|github_pat)_[A-Za-z0-9_]{20,}"
    },
    {
      "name": "AWS access key",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "name": "Private key block",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "name": "Bearer token",
      "regex": "Bearer\\s+[A-Za-z0-9._-]{20,}"
    },
    {
      "name": "Generic credential assignment",
      "regex": "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*['\\\"][^'\\\"]{8,}['\\\"]"
    }
  ],
  "commit_message_patterns": [
    {
      "name": "Commit message secret",
      "regex": "(?i)(api[_-]?key|secret|token|password|bearer)\\b.{0,80}"
    }
  ]
}
